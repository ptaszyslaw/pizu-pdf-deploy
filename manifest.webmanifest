{
  "id": "/pdf/",
  "name": "PizuPDF",
  "short_name": "PizuPDF",
  "description": "Darmowe narzędzia PDF działające w Twojej przeglądarce — bez wysyłania plików na serwer; większość działa też bez internetu.",
  "lang": "pl",
  "dir": "ltr",
  "start_url": "/pdf/",
  "scope": "/pdf/",
  "display": "standalone",
  "background_color": "#F7F7F8",
  "theme_color": "#EF4249",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/pdf/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pdf/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pdf/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/pdf/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
