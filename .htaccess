# PizuPDF — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On

  # pdf.ptaszynski.pl (and the www. variants) share this folder with
  # pdf.pizu.pl, so the move to the new address has to live here — every
  # deploy replaces this file, a redirect set in cPanel would be wiped
  RewriteCond %{HTTP_HOST} ^(www\.)?pdf\.ptaszynski\.pl$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.pdf\.pizu\.pl$ [NC]
  RewriteRule ^ https://pdf.pizu.pl%{REQUEST_URI} [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Module JS workers require a JavaScript MIME type
AddType application/javascript .mjs

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
