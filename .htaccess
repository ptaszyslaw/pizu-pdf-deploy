# PizuPDF — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: everything but https://pdf.pizu.pl that reaches this folder
  # (http, www.pdf.pizu.pl, ptasior.hostilla.pl/pdf/, the old pdf.ptaszynski.pl
  # if it ever points here again) gets a single 301 to https://pdf.pizu.pl,
  # path and query kept. Path from $1 (relative to this folder), not
  # %{REQUEST_URI}, so ptasior.hostilla.pl/pdf/x lands on /x; without NE Apache
  # encodes spaces and % in the target. /.well-known stays put for AutoSSL.
  # Lives here, not in cPanel "Redirects" — every deploy replaces this file.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^pdf\.pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://pdf.pizu.pl/$1 [R=301,L]
</IfModule>

# Module JS workers require a JavaScript MIME type
AddType application/javascript .mjs
# pdf.js decoders (pdfjs/wasm) — the server sent them with no type at all
AddType application/wasm .wasm

# Wrong addresses get the Pizu 404 page (404.html, copied from pizu-pl/shell by
# scripts/sync-shell.mjs there) instead of the hosting's generic error page.
# Root-relative, so it works under any path; the status stays 404.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers on every response
  # HSTS only over HTTPS (browsers ignore it over http, which is redirected above
  # anyway). No includeSubDomains/preload: cPanel also has mail., webmail. etc.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Own browsing context group: a page that opens this one (or that this one opens)
  # gets no window handle to it. Nothing here uses cross-origin popups.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # The page's CSP: scripts/deploy.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and pdf.js / Tesseract
  # compile WebAssembly there, which this page policy doesn't allow.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://o4512300568477696.ingest.de.sentry.io; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
