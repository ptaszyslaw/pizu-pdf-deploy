# PizuPDF — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On

  # pdf.ptaszynski.pl (and the www. variants) share this folder with
  # pdf.pizu.pl, so the move to the new address has to live here — every
  # deploy replaces this file, a redirect set in cPanel would be wiped
  RewriteCond %{HTTP_HOST} ^(www\.)?pdf\.ptaszynski\.pl$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.pdf\.pizu\.pl$ [NC]
  RewriteRule ^ https://pdf.pizu.pl%{REQUEST_URI} [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Module JS workers require a JavaScript MIME type
AddType application/javascript .mjs
# pdf.js decoders (pdfjs/wasm) — the server sent them with no type at all
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers on every response
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # The page's CSP: scripts/deploy.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and pdf.js / Tesseract
  # compile WebAssembly there, which this page policy doesn't allow.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
