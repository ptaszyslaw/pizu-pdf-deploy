# PizuPDF — Apache config for shared hosting (folder public_html/pizu/pdf, https://pizu.pl/pdf/).
# scripts/hosting.mjs fills the CSP placeholder from index.html's <meta> in the website build;
# the desktop build never serves this file.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: https://pizu.pl/pdf/. Everything else that reaches this folder —
  # http, www.pizu.pl, the hosting's own address under the pizu.pl account — gets
  # a single 301 to https://pizu.pl/pdf/, path and query kept. Path from $1
  # (relative to this folder), not %{REQUEST_URI}; without NE Apache encodes
  # spaces and % in the target. /.well-known stays put for AutoSSL.
  # Lives here, not in cPanel "Redirects" — every deploy replaces this file.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://pizu.pl/pdf/$1 [R=301,L]
</IfModule>

# Module JS workers require a JavaScript MIME type
AddType application/javascript .mjs
# pdf.js decoders (pdfjs/wasm) — the server sent them with no type at all
AddType application/wasm .wasm
# Installable website (scripts/pwa.mjs)
AddType application/manifest+json .webmanifest

# Wrong addresses get the Pizu 404 page (404.html, copied from pizu-pl/shell by
# scripts/sync-shell.mjs there) instead of the hosting's generic error page.
# The URL starts at the site root — under /pdf/ this file is /pdf/404.html.
ErrorDocument 404 /pdf/404.html

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The service worker decides which version visitors run: never from a cache (browsers mostly
  # skip the HTTP cache for it anyway). The manifest: name and icons of installed apps.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers on every response
  # HSTS only over HTTPS (browsers ignore it over http, which is redirected above
  # anyway). No includeSubDomains/preload: cPanel also has mail., webmail. etc.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Own browsing context group: a page that opens this one (or that this one opens)
  # gets no window handle to it. Nothing here uses cross-origin popups.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # The page's CSP: scripts/hosting.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and pdf.js / Tesseract
  # compile WebAssembly there, which this page policy doesn't allow. The same goes for sw.js;
  # the page's worker-src 'self' lets it register, and default-src 'self' covers the manifest.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://o4512300568477696.ingest.de.sentry.io; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
