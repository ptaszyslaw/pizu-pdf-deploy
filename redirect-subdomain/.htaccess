# Generated by scripts/deploy.mjs — PizuPDF moved to https://pizu.pl/pdf/ (do not edit in this repository).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Everything this folder used to serve now lives on pizu.pl: one 301 per address,
  # path and query kept. Two exceptions:
  # - sw.js stays here: browsers check for service worker updates at the exact address
  #   they registered and never follow redirects for it — without the retiring worker
  #   below, installed PWAs would keep the old app forever,
  # - /.well-known/ stays put for AutoSSL.
  RewriteCond %{REQUEST_URI} !^/sw\.js(?:$|\?)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://pizu.pl/pdf/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # The retiring sw.js must be fetched fresh — the browser decides on it alone
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
